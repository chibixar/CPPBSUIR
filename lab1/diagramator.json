{
  "version": 2,
  "output": "diagram.typ",
  "autoExport": true,
  "style": {
    "styleVersion": 2,
    "name": "GOST",
    "font": [
      "Times New Roman",
      "Liberation Serif",
      "serif"
    ],
    "fontSize": 13.0,
    "nameFontSize": 14.0,
    "stereotypeFontSize": 11.0,
    "lineHeight": 18.0,
    "paddingX": 8.0,
